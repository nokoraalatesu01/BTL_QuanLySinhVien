@page
@model BTL_QuanLySinhVien.Pages.TeacherPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Teacher[0].FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Teacher[0].AcademicTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Teacher[0].Department)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Teacher) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.AcademicTitle)
            </td>
            <td>
                @Html.DisplayFor(model => item.Department)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.TeacherId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.TeacherId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.TeacherId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
