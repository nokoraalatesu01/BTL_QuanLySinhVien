@page
@model BTL_QuanLySinhVien.Pages.IndexModel
@inject IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Tổng quan";
}

<section class="page-heading">
    <p class="eyebrow">TRANG CHỦ</p>
    <h1>Chào mừng đến với hệ thống</h1>
    <p class="page-description">Chọn một chức năng để bắt đầu quản lý dữ liệu đào tạo.</p>
</section>

<div class="dashboard-grid">
    <section class="dashboard-card">
        <div class="dashboard-card-icon student-icon" aria-hidden="true">SV</div>
        <div class="dashboard-card-copy">
            <h2>Sinh viên</h2>
            <p>Quản lý hồ sơ và thông tin sinh viên.</p>
        </div>
        <a class="button button-secondary" asp-page="/StudentsPages/Index">Mở danh sách</a>
    </section>

    <section class="dashboard-card">
        <div class="dashboard-card-icon teacher-icon" aria-hidden="true">GV</div>
        <div class="dashboard-card-copy">
            <h2>Giảng viên</h2>
            <p>Quản lý thông tin giảng viên.</p>
        </div>
        <a class="button button-secondary" asp-page="/TeachersPages/Index">Mở danh sách</a>
    </section>

    <section class="dashboard-card">
        <div class="dashboard-card-icon course-icon" aria-hidden="true">MH</div>
        <div class="dashboard-card-copy">
            <h2>Môn học</h2>
            <p>Quản lý danh mục môn học và số tín chỉ.</p>
        </div>
        <a class="button button-secondary" asp-page="/CoursesPages/Index">Mở danh sách</a>
    </section>

    @if (HostEnvironment.IsDevelopment())
    {
        <section class="dashboard-card">
            <div class="dashboard-card-icon api-icon" aria-hidden="true">API</div>
            <div class="dashboard-card-copy">
                <h2>Tài liệu API</h2>
                <p>Swagger OpenAPI dành cho ứng dụng khách.</p>
            </div>
            <a class="button button-secondary" href="/swagger" target="_blank" rel="noopener noreferrer">Mở Swagger</a>
        </section>
    }
</div>