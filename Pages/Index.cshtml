@page
@model BTL_QuanLySinhVien.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

@if (Model.HasUnsupportedRole)
{
    <section class="page-heading">
        <p class="eyebrow">TÀI KHOẢN</p>
        <h1>Tài khoản chưa được phân quyền</h1>
        <p class="page-description">Vui lòng liên hệ quản trị viên để được cấp vai trò phù hợp.</p>
    </section>
}
else
{
    <section class="page-heading">
        <p class="eyebrow">TRANG CHỦ</p>
        <h1>Chào mừng đến với hệ thống</h1>
        <p class="page-description">Đăng nhập để truy cập dashboard theo vai trò của bạn.</p>
        <a class="button button-primary" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    </section>
}