@page
@model BTL_QuanLySinhVien.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ Quản trị";
}

<div class="text-center my-5">
    <h1 class="display-4 text-primary font-weight-bold">Hệ Thống Quản Lý Đào Tạo</h1>
    <p class="lead text-secondary">Chào mừng bạn đến với nền tảng Enterprise Web API & Razor Pages (.NET 10)</p>
    <hr class="my-4">
</div>

<div class="row text-center">
    <!-- Quản lý Sinh viên -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h3 class="card-title text-success">Sinh Viên</h3>
                    <p class="card-text text-muted">Quản lý hồ sơ, thông tin và danh sách sinh viên toàn trường.</p>
                </div>
                <a href="/Students" class="btn btn-outline-success mt-3">Truy cập Quản lý</a>
            </div>
        </div>
    </div>

    <!-- Quản lý Giảng viên -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h3 class="card-title text-info">Giảng Viên</h3>
                    <p class="card-text text-muted">Quản lý thông tin giảng viên, học hàm học vị và khoa công tác.</p>
                </div>
                <a href="/Teachers" class="btn btn-outline-info mt-3">Truy cập Quản lý</a>
            </div>
        </div>
    </div>

    <!-- Quản lý Môn học -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h3 class="card-title text-warning">Môn Học</h3>
                    <p class="card-text text-muted">Danh mục học phần, số tín chỉ và chương trình đào tạo.</p>
                </div>
                <a href="/Courses" class="btn btn-outline-warning mt-3">Truy cập Quản lý</a>
            </div>
        </div>
    </div>

    <!-- Tài liệu API (Swagger) -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h3 class="card-title text-danger">Web API</h3>
                    <p class="card-text text-muted">Tài liệu Swagger OpenAPI phục vụ cho Mobile App / Client.</p>
                </div>
                <a href="/swagger" target="_blank" class="btn btn-outline-danger mt-3">Mở Swagger UI</a>
            </div>
        </div>
    </div>
</div>