@page
@model BTL_QuanLySinhVien.Pages.StudentsPages.DetailsModel

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<h1>Chi tiết sinh viên</h1>

<div class="details-card">
    <dl class="details-list">
        <dt>Mã sinh viên</dt>
        <dd>@Model.Student.StudentId</dd>
        <dt>Họ và tên</dt>
        <dd>@Model.Student.FullName</dd>
        <dt>Ngày sinh</dt>
        <dd>@Model.Student.DateOfBirth.ToString("dd/MM/yyyy")</dd>
        <dt>Ngành</dt>
        <dd>@Model.Student.Major</dd>
        <dt>Số học phần đã đăng ký</dt>
        <dd>@(Model.Student.Enrollments?.Count ?? 0)</dd>
    </dl>
</div>
<div class="page-actions">
    <a class="button button-primary" asp-page="./Edit" asp-route-id="@Model.Student.StudentId">Sửa thông tin</a>
    <a class="button button-secondary" asp-page="./Index">Quay lại danh sách</a>
</div>
