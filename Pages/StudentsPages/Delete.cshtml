@page
@model BTL_QuanLySinhVien.Pages.StudentsPages.DeleteModel

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<h1>Xóa sinh viên</h1>

<div class="status-message status-message-error" role="alert">
    Xác nhận xóa hồ sơ của <strong>@Model.Student.FullName</strong> (mã @Model.Student.StudentId).
    Hồ sơ có học phần đã đăng ký sẽ không bị xóa.
</div>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="details-card">
    <dl class="details-list">
        <dt>Mã sinh viên</dt>
        <dd>@Model.Student.StudentId</dd>
        <dt>Họ và tên</dt>
        <dd>@Model.Student.FullName</dd>
        <dt>Ngày sinh</dt>
        <dd>@Model.Student.DateOfBirth.ToString("dd/MM/yyyy")</dd>
        <dt>Ngành</dt>
        <dd>@Model.Student.Major</dd>
        <dt>Số học phần đã đăng ký</dt>
        <dd>@(Model.Student.Enrollments?.Count ?? 0)</dd>
    </dl>
</div>
<div class="page-actions">
    <form method="post" asp-route-id="@Model.Student.StudentId"
          onsubmit="return confirm('Bạn có chắc chắn muốn xóa hồ sơ sinh viên này?');">
        <input type="hidden" asp-for="Student.StudentId" />
        <button type="submit" class="btn btn-danger">Xóa sinh viên</button>
    </form>
    <a class="button button-secondary" asp-page="./Index">Hủy và quay lại</a>
</div>
