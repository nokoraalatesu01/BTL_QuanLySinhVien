@page
@model BTL_QuanLySinhVien.Pages.StudentsPages.EditModel

@{
    ViewData["Title"] = "Sửa thông tin sinh viên";
}

<h1>Sửa thông tin sinh viên</h1>

<p class="page-description">Cập nhật thông tin hồ sơ sinh viên.</p>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" asp-route-id="@Model.Student.StudentId">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Student.StudentId" />
            <input type="hidden" asp-for="OriginalValuesToken" />
            <div class="form-group">
                <label asp-for="Student.StudentId" class="control-label"></label>
                <input class="form-control" value="@Model.Student.StudentId" readonly />
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Student.FullName" class="control-label"></label>
                <input asp-for="Student.FullName" class="form-control" aria-required="true" required />
                <span asp-validation-for="Student.FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Student.DateOfBirth" class="control-label"></label>
                <input asp-for="Student.DateOfBirth" class="form-control" />
                <span asp-validation-for="Student.DateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Student.Major" class="control-label"></label>
                <input asp-for="Student.Major" class="form-control" aria-required="true" required />
                <span asp-validation-for="Student.Major" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="button button-primary">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a class="button button-secondary" asp-page="./Index">Quay lại danh sách</a>
</div>
