@page
@model BTL_QuanLySinhVien.Pages.Dashboard.Student.IndexModel

@{
    ViewData["Title"] = "Dashboard sinh viên";
}

<section class="page-heading">
    <p class="eyebrow">SINH VIÊN</p>
    <h1>Dashboard sinh viên</h1>
    @if (!Model.HasLinkedProfile)
    {
        <p class="page-description">Tài khoản của bạn chưa được liên kết với hồ sơ sinh viên. Vui lòng liên hệ quản trị viên.</p>
    }
    else
    {
        <p class="page-description">Thông tin hồ sơ sinh viên được liên kết với tài khoản của bạn.</p>
    }
</section>

@if (Model.Profile is not null)
{
    <section class="dashboard-card">
        <div class="dashboard-card-copy">
            <h2>@Model.Profile.FullName</h2>
            <p>Mã sinh viên: @Model.Profile.StudentId</p>
            <p>Ngày sinh: @Model.Profile.DateOfBirth.ToString("dd/MM/yyyy")</p>
            <p>Ngành: @Model.Profile.Major.Name</p>
        </div>
    </section>
}
