@page
@model BTL_QuanLySinhVien.Pages.TeachersPages.DeleteModel

@{
    ViewData["Title"] = "Xóa giảng viên";
}

<h1>Xóa giảng viên</h1>

<div class="status-message status-message-error" role="alert">
    Xác nhận xóa hồ sơ của <strong>@Model.Teacher.FullName</strong> (mã @Model.Teacher.TeacherId).
    Dữ liệu liên quan sẽ không bị xóa.
</div>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="details-card">
    <dl class="details-list">
        <dt>Mã giảng viên</dt>
        <dd>@Model.Teacher.TeacherId</dd>
        <dt>Họ và tên</dt>
        <dd>@Model.Teacher.FullName</dd>
        <dt>Học hàm/học vị</dt>
        <dd>@Model.Teacher.AcademicTitle</dd>
        <dt>Khoa/bộ môn</dt>
        <dd>@Model.Teacher.Department</dd>
    </dl>
</div>
<div class="page-actions">
    <form method="post" asp-route-id="@Model.Teacher.TeacherId"
          onsubmit="return confirm('Bạn có chắc chắn muốn xóa hồ sơ giảng viên này?');">
        <button type="submit" class="btn btn-danger">Xóa giảng viên</button>
    </form>
    <a class="button button-secondary" asp-page="./Index">Hủy và quay lại</a>
</div>
