@page
@model BTL_QuanLySinhVien.Pages.TeachersPages.DetailsModel

@{
    ViewData["Title"] = "Chi tiết giảng viên";
}

<h1>Chi tiết giảng viên</h1>

<div class="details-card">
    <dl class="details-list">
        <dt>Mã giảng viên</dt>
        <dd>@Model.Teacher.TeacherId</dd>
        <dt>Họ và tên</dt>
        <dd>@Model.Teacher.FullName</dd>
        <dt>Học hàm/học vị</dt>
        <dd>@Model.Teacher.AcademicTitle</dd>
        <dt>Khoa/bộ môn</dt>
        <dd>@Model.Teacher.Department</dd>
    </dl>
</div>
<div class="page-actions">
    <a class="button button-primary" asp-page="./Edit" asp-route-id="@Model.Teacher.TeacherId">Sửa thông tin</a>
    <a class="button button-secondary" asp-page="./Index">Quay lại danh sách</a>
</div>
