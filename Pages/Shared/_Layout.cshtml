<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#12243a" />
    <title>@ViewData["Title"] - Quản lý đào tạo</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <a class="brand" asp-page="/Index" aria-label="Trang chủ quản lý đào tạo">
            <span class="brand-mark" aria-hidden="true">QL</span>
            <span class="brand-copy">
                <span class="brand-name">Quản lý đào tạo</span>
                <span class="brand-caption">Cổng quản trị</span>
            </span>
        </a>
        <div class="header-account">
            <partial name="_LoginPartial" />
        </div>
    </header>

    <div class="app-layout">
        <aside class="sidebar" aria-label="Thanh điều hướng">
            <p class="sidebar-heading">DANH MỤC</p>
            <nav class="sidebar-nav" aria-label="Điều hướng chính">
                <a class="sidebar-link @(Context.Request.Path == "/" ? "active" : null)"
                   asp-page="/Index"
                   aria-current="@(Context.Request.Path == "/" ? "page" : null)">
                    <span class="nav-icon" aria-hidden="true">T</span>
                    <span>Tổng quan</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/StudentsPages") ? "active" : null)"
                       asp-page="/StudentsPages/Index"
                       aria-current="@(Context.Request.Path.StartsWithSegments("/StudentsPages") ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true">SV</span>
                        <span>Sinh viên</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/TeachersPages") ? "active" : null)"
                       asp-page="/TeachersPages/Index"
                       aria-current="@(Context.Request.Path.StartsWithSegments("/TeachersPages") ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true">GV</span>
                        <span>Giảng viên</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/CoursesPages") ? "active" : null)"
                       asp-page="/CoursesPages/Index"
                       aria-current="@(Context.Request.Path.StartsWithSegments("/CoursesPages") ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true">MH</span>
                        <span>Môn học</span>
                    </a>
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Admin/Users") ? "active" : null)"
                       asp-page="/Admin/Users/Index"
                       aria-current="@(Context.Request.Path.StartsWithSegments("/Admin/Users") ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true">TK</span>
                        <span>Tài khoản</span>
                    </a>
                }
                else if (User.IsInRole("Teacher"))
                {
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Dashboard/Teacher") ? "active" : null)"
                       asp-page="/Dashboard/Teacher/Index"
                       aria-current="@(Context.Request.Path.StartsWithSegments("/Dashboard/Teacher") ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true">GV</span>
                        <span>Dashboard giảng viên</span>
                    </a>
                }
                else if (User.IsInRole("Student"))
                {
                    <a class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Dashboard/Student") ? "active" : null)"
                       asp-page="/Dashboard/Student/Index"
                       aria-current="@(Context.Request.Path.StartsWithSegments("/Dashboard/Student") ? "page" : null)">
                        <span class="nav-icon" aria-hidden="true">SV</span>
                        <span>Dashboard sinh viên</span>
                    </a>
                }
            </nav>
            <div class="sidebar-note">
                Quản lý hồ sơ và chương trình đào tạo
            </div>
        </aside>

        <div class="workspace">
            <main class="page-content">
                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    <div class="status-message" role="status">@statusMessage</div>
                }
                @RenderBody()
            </main>
            <footer class="site-footer">
                <span>Hệ thống quản lý đào tạo</span>
            </footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
