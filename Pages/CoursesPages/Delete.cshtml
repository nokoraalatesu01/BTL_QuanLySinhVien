@page
@model BTL_QuanLySinhVien.Pages.CoursesPages.DeleteModel

@{
    ViewData["Title"] = "Xóa môn học";
}

<h1>Xóa môn học</h1>

<div class="status-message status-message-error" role="alert">
    Xác nhận xóa môn học <strong>@Model.Course.CourseName</strong> (mã @Model.Course.CourseId).
    Môn học còn sinh viên đăng ký sẽ không bị xóa.
</div>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="details-card">
    <dl class="details-list">
        <dt>Mã môn học</dt>
        <dd>@Model.Course.CourseId</dd>
        <dt>Tên môn học</dt>
        <dd>@Model.Course.CourseName</dd>
        <dt>Số tín chỉ</dt>
        <dd>@Model.Course.Credits</dd>
        <dt>Số lượt đăng ký</dt>
        <dd>@(Model.Course.Enrollments?.Count ?? 0)</dd>
    </dl>
    <div class="page-actions">
    <form method="post" asp-route-id="@Model.Course.CourseId"
          onsubmit="return confirm('Bạn có chắc chắn muốn xóa môn học này?');">
        <input type="hidden" asp-for="Course.CourseId" />
        <button type="submit" class="btn btn-danger">Xóa môn học</button>
    </form>
    <a class="button button-secondary" asp-page="./Index">Hủy và quay lại</a>
    </div>
</div>
